#!/bin/sh
# ============================================================
# Ejemplo para DNTSI — cargar secreto Oracle en Vault (KV v2)
# salud-geolocalizacion-api · DIRGEN_USR
#
# Uso (QA o PROD — ajustar variables y VAULT_ADDR / token):
#   export VAULT_ADDR=https://<VAULT_HOST>:8200
#   export VAULT_TOKEN=<token-dntsi>
#   sh cargar-secreto-oracle.sh.example qa
#   sh cargar-secreto-oracle.sh.example prod
# ============================================================

AMBIENTE="${1:-qa}"

case "$AMBIENTE" in
  qa)
    ORACLE_HOST="<ORACLE_HOST_QA>"
    ORACLE_SERVICE="<ORACLE_SERVICE_QA>"
    ORACLE_PASSWORD="<ORACLE_PASSWORD_QA>"
    ;;
  prod)
    ORACLE_HOST="<ORACLE_HOST_PROD>"
    ORACLE_SERVICE="<ORACLE_SERVICE_PROD>"
    ORACLE_PASSWORD="<ORACLE_PASSWORD_PROD>"
    ;;
  *)
    echo "Ambiente invalido: $AMBIENTE (use qa o prod)"
    exit 1
    ;;
esac

vault secrets enable -path=salud-geolocalizacion-api kv-v2 2>/dev/null || true

vault kv put salud-geolocalizacion-api/database/oracle \
  host="$ORACLE_HOST" \
  port=1521 \
  service="$ORACLE_SERVICE" \
  username=DIRGEN_USR \
  password="$ORACLE_PASSWORD" \
  schema=DIRGEN_USR

echo "[OK] Secreto cargado: salud-geolocalizacion-api/database/oracle ($AMBIENTE)"
vault kv get salud-geolocalizacion-api/database/oracle
