# ============================================================
# BaseSpringApi — Variables de entorno (EJEMPLO)
# Copiar: cp .env.example .env  y completar valores
# ============================================================

# IP_SERVER= (vacío=local | IP=dockerizado, ej: 192.168.12.42)
IP_SERVER=

SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api

# Motor activo: oracle | mock
DB_ENGINE=oracle

# --- Oracle DBDVP (producción / desarrollo DIRGEN) -------- [VAULT en Etapa 2]
DB_ORACLE_HOST=192.168.29.66
DB_ORACLE_PORT=1521
DB_ORACLE_SERVICE=DBDVP
DB_ORACLE_USERNAME=DIRGEN_OWNER
DB_ORACLE_PASSWORD=
DB_ORACLE_DDL_AUTO=validate
DB_ORACLE_SHOW_SQL=false

# --- Servicios opcionales (Etapa 2) ------------------------
VAULT_ENABLED=false
VAULT_HOST=localhost
VAULT_PORT=8200
VAULT_SCHEME=http
VAULT_TOKEN=root-token

MONGO_ENABLED=false
DB_MONGO_HOST=localhost
DB_MONGO_PORT=27017
DB_MONGO_NAME=AUDITORIA_IESS
DB_MONGO_USERNAME=mongo_user
DB_MONGO_PASSWORD=mongo_password
DB_MONGO_AUTH_DB=admin

MINIO_ENABLED=false

# --- Swagger -------------------------------------------------
SWAGGER_ENABLED=true
