# ============================================================
# BaseSpringApi — Variables de entorno (EJEMPLO)
# Copiar: cp .env.example .env  y completar valores
# ============================================================

# IP_SERVER= (vacío=local | IP=dockerizado, ej: 192.168.12.42)
IP_SERVER=

SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api

# Motor activo: oracle | postgres | mock
DB_ENGINE=oracle

# --- Oracle DBDVP (producción / desarrollo DIRGEN) -------- [VAULT en Etapa 2]
DB_ORACLE_HOST=192.168.29.66
DB_ORACLE_PORT=1521
DB_ORACLE_SERVICE=DBDVP
DB_ORACLE_USERNAME=DIRGEN_OWNER
DB_ORACLE_PASSWORD=
DB_ORACLE_DDL_AUTO=validate
DB_ORACLE_SHOW_SQL=false

# --- PostgreSQL local (esquema salud) ---------------------- [VAULT en Etapa 2]
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5432
DB_POSTGRES_NAME=iess_salud
DB_POSTGRES_USERNAME=iess_salud_user
DB_POSTGRES_PASSWORD=
DB_POSTGRES_DDL_AUTO=validate
DB_POSTGRES_SHOW_SQL=false

# --- Legacy (deprecado — usar DB_ORACLE_* / DB_POSTGRES_*) ---
# DB_HOST=
# DB_PORT=
# DB_SERVICE=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# --- Servicios opcionales (Etapa 2) ------------------------
VAULT_ENABLED=false
VAULT_HOST=localhost
VAULT_PORT=8200
VAULT_SCHEME=http
VAULT_TOKEN=root-token

MONGO_ENABLED=false
DB_MONGO_HOST=localhost
DB_MONGO_PORT=27017
DB_MONGO_NAME=AUDITORIA_IESS
DB_MONGO_USERNAME=mongo_user
DB_MONGO_PASSWORD=mongo_password
DB_MONGO_AUTH_DB=admin

MINIO_ENABLED=false

# --- Swagger -------------------------------------------------
SWAGGER_ENABLED=true
