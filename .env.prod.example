# ============================================================
# salud-geolocalizacion-api — PRODUCCIÓN
# En el servidor:
#   cp .env.prod.example .env
#   completar <...>  — NO subir el .env real a Git
#
# Docker: env_file: .env
# Secretos: variables de entorno (sin HashiCorp Vault).
# Acordado con Arquitectura y Seguridades.
# ============================================================

SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api
DB_ENGINE=oracle

DB_ORACLE_HOST=<ORACLE_HOST_PROD>
DB_ORACLE_PORT=1521
DB_ORACLE_SERVICE=<ORACLE_SERVICE_PROD>
DB_ORACLE_USERNAME=<ORACLE_USER_PROD>
DB_ORACLE_PASSWORD=<ORACLE_PASSWORD_PROD>

DB_ORACLE_DDL_AUTO=validate
DB_ORACLE_SHOW_SQL=false

SWAGGER_ENABLED=false
